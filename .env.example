# Desktop defaults; saved application preferences take precedence.
JEV_AGENT_PROVIDER=laya
JEV_AGENT_LAYA_MODEL=aac6fef/laya-multilingual-mlx
JEV_AGENT_LAYA_REVISION=ba40c87fcb357f1643d04d71323af9cdc3b9e591
JEV_AGENT_DECISION_TIMEOUT_MS=2000
# Required only for local CLI tests of Jev; desktop uses macOS Keychain.
TYPESAFE_API_KEY=YOUR_TYPESAFE_API_KEY
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# Optional, required for bounded live acceptance batches; use an absolute path.
# JEV_AGENT_LIVE_BUDGET_FILE=/absolute/path/to/private/jev-budget.json
JEV_AGENT_LIVE_BUDGET_LIMIT=120
